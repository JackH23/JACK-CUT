# Allowlist: use the repository root as the build context.
**
!backend/
backend/*
!backend/package.json
!backend/package-lock.json
!backend/server.js
!backend/config/
!backend/config/**
!backend/controllers/
!backend/controllers/**
!backend/middleware/
!backend/middleware/**
!backend/models/
!backend/models/**
!backend/routes/
!backend/routes/**
!backend/services/
!backend/services/**
!backend/utils/
!backend/utils/**
!frontend/
frontend/*
!frontend/lib/
frontend/lib/*
!frontend/lib/textLayout.json
!frontend/lib/mediaAnimation.js
!frontend/lib/textAnimation.js
# Defense in depth, including secrets accidentally placed under allowed directories.
**/.env
**/.env.*
**/node_modules
**/.git
**/uploads
**/exports
**/tmp
**/temp
**/scratch
**/render-*
**/*.pem
**/*.key
**/*.p12
